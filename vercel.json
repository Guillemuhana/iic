{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-review",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-daily",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net blob:; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob: mediastream:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net data: blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
