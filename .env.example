# ---------- Frontend (públicas, van al navegador) ----------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_o_publishable_key

# ---------- Servidor (solo en Vercel > Settings > Environment Variables) ----------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Groq (lectura de tickets)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Modelo de visión de Groq. Si Groq lo cambia, actualizalo acá sin tocar código.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Email a la contadora (SMTP). Con Gmail: smtp.gmail.com, puerto 465 y una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=comprobantes@tudominio.com
SMTP_PASS=contraseña_de_aplicacion
MAIL_FROM="IIC Comprobantes <comprobantes@tudominio.com>"
MAIL_REPLY_TO=
ACCOUNTANT_EMAIL=estudiocaballerosalva@gmail.com

# Protege el envío semanal del viernes a las 12:00 de Argentina
CRON_SECRET=una_cadena_larga_y_aleatoria

# Solo para desarrollo local con `npm run dev`: a dónde mandar /api
# VITE_API_PROXY=https://tu-deploy.vercel.app
